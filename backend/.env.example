# Copy this file to .env and fill in real values before running the backend.

PORT=3000
CLIENT_ORIGIN=http://localhost:5173

# Secret used to sign session cookies - use a long random string in production
SESSION_SECRET=replace-with-a-long-random-string

# FR15: initial administrator account, seeded once on first start-up.
# ADMIN_IDENTIFIER_NUMBER is the professional identifying number (SANC/SAPC
# style) used to log in - ADMIN_EMAIL is optional.
ADMIN_IDENTIFIER_NUMBER=ADMIN0001
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisPassword123
